{
  "name": "react-blog",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "biome check src worker scripts tests",
    "check:ts": "astro check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "fix": "biome check --write src worker scripts tests",
    "new-post": "node --experimental-strip-types scripts/new-post.ts",
    "fonts": "astro build && node scripts/subset-fonts.mjs && astro build",
    "fonts:check": "node scripts/subset-fonts.mjs --check",
    "posts:check": "node --experimental-strip-types scripts/check-draft-questions.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "shadcn": "^4.21.0",
    "subset-font": "^2.7.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "stream-replace-string@npm:^2.0.0": "patch:stream-replace-string@npm%3A2.0.0#~/.yarn/patches/stream-replace-string-npm-2.0.0-2e7e10c117.patch",
    "yaml-language-server/yaml": "^2.9.0"
  }
}
