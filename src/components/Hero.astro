---
// Hero 文言は Q1 の 3 案から運営者が案 3 を選定（2026-06-07）
const name = "谷本 和也";
const nameEn = "Kazuya Tanimoto";
const title = "PM / PO・フルスタックエンジニア";
const copy = "現場を前に進める PM / PO";
const summary =
  "設計も開発もマネジメントも。25年の現場経験とAI活用で、停滞しないチームをつくります。";
---

<section class="relative overflow-hidden bg-gradient-to-b from-hibari-wash to-background">
  <!-- 署名要素「揚雲雀の軌跡」（PHASE1C-008。docs/design-direction.md §5）。
       左下から右上へ点線で昇る飛行線 + ヒバリ + 朝日。サイト内で 1 ページ 1 回だけ使う。
       意味を持たない装飾なので読み上げ対象外にし、クリックも透過させる -->
  <svg
    class="pointer-events-none absolute right-4 bottom-2 h-auto w-80 max-w-[45%] opacity-30 sm:opacity-90"
    viewBox="0 0 320 180"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M10 170 C 90 160, 180 120, 250 60"
      stroke="var(--color-hibari-sky)"
      stroke-width="2"
      stroke-dasharray="1 10"
      stroke-linecap="round"
      opacity="0.55"
    ></path>
    <g transform="translate(252 44) rotate(-18)">
      <path
        d="M0 8 C 6 2, 14 0, 22 3 C 16 6, 12 7, 9 12 C 7 9, 4 8, 0 8 Z"
        fill="var(--color-hibari-sky)"
        opacity="0.8"></path>
      <path
        d="M9 12 C 12 14, 18 15, 24 13 C 19 17, 13 18, 8 16 Z"
        fill="var(--color-hibari-sky)"
        opacity="0.55"></path>
    </g>
    <circle cx="292" cy="26" r="14" fill="url(#hero-sun)" opacity="0.9"></circle>
    <defs>
      <radialGradient id="hero-sun" cx="0.35" cy="0.35" r="1">
        <stop offset="0%" stop-color="var(--color-hibari-sun-light)"></stop>
        <stop offset="100%" stop-color="var(--color-hibari-sun)"></stop>
      </radialGradient>
    </defs>
  </svg>

  <div class="relative mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <p
      class="inline-block rounded-full bg-accent px-3.5 py-0.5 text-sm font-bold tracking-wide text-accent-foreground"
    >
      {title}
    </p>
    <h1 class="mt-4 text-3xl font-bold text-foreground sm:text-4xl">
      {name}
      <span class="ml-2 font-sans text-lg font-medium text-muted-foreground">{nameEn}</span>
    </h1>
    <p class="mt-4 font-heading text-xl font-medium text-foreground sm:text-2xl">{copy}</p>
    <p class="mt-3 max-w-2xl text-muted-foreground">{summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/career"
        class="rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-primary-foreground shadow-card transition-colors hover:bg-hibari-sky-deep"
      >
        経歴を見る
      </a>
      <a
        href="/contact"
        class="rounded-full bg-card px-6 py-2.5 text-sm font-medium text-foreground shadow-card transition-colors hover:bg-hibari-wash"
      >
        お問い合わせ
      </a>
    </div>
  </div>
</section>
