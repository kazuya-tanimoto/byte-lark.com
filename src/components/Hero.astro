---
// Hero 文言は Q1 の 3 案から運営者が案 3 を選定（2026-06-07）
const name = "谷本 和也";
const nameEn = "Kazuya Tanimoto";
const title = "PM / PO・フルスタックエンジニア";
const copy = "現場を前に進める PM / PO";
const summary =
  "設計も開発もマネジメントも。25年の現場経験とAI活用で、停滞しないチームをつくります。";
---

<section class="border-b border-border bg-muted/30">
  <div class="mx-auto max-w-5xl px-4 py-16 sm:py-20">
    <p class="text-sm font-medium text-hibari-sky">{title}</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      {name}
      <span class="ml-2 text-lg font-normal text-muted-foreground">{nameEn}</span>
    </h1>
    <p class="mt-4 text-xl font-semibold text-foreground sm:text-2xl">{copy}</p>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">{summary}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/career"
        class="rounded-md bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90"
      >
        経歴を見る
      </a>
      <a
        href="/contact"
        class="rounded-md border border-border bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted"
      >
        お問い合わせ
      </a>
    </div>
  </div>
</section>
