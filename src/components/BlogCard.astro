---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { formatPostDate, postSlug, toIsoDate } from "../lib/posts";
import PostChips from "./PostChips.astro";

interface Props {
  post: CollectionEntry<"posts">;
  /** カードタイトルの見出しレベル。既定は h3（Home の h2 セクション配下）。
      h1 直下の一覧（/blog/）では h2 を渡して見出し階層を保つ */
  headingLevel?: "h2" | "h3";
  /** 最初から見えている位置のカードに付ける。画像を後回しにせず先に取りにいく
      （loading=eager / fetchpriority=high）。1 ページに 1 枚だけ */
  priority?: boolean;
}

const { post, headingLevel = "h3", priority = false } = Astro.props;
const { title, description, category, publishedAt, cover, draft } = post.data;
const href = `/blog/${postSlug(post)}/`;
// 見た目のサイズはタグと独立（クラス側で吸収）。タグだけ切り替える
const Heading = headingLevel;
---

<!-- h-full: 格子の子（/blog/ の <li>）は伸びるが中の <article> は中身ぶんで止まるため、
     明示しないと同じ行のカードで高さが揃わない。Home はカードが格子の直接の子なので影響なし -->
<article class="h-full overflow-hidden rounded-lg bg-card shadow-card transition-transform motion-safe:hover:-translate-y-0.5">
  <a href={href} class="flex h-full flex-col">
    {
      cover && (
        <Image
          src={cover}
          alt=""
          width={640}
          height={336}
          priority={priority}
          class="aspect-[40/21] w-full object-cover"
        />
      )
    }
    <div class="flex flex-1 flex-col gap-2 p-4">
      <div class="flex items-center gap-2 text-xs text-muted-foreground">
        <PostChips category={category} draft={draft} />
        <time datetime={toIsoDate(publishedAt)}>
          {formatPostDate(publishedAt)}
        </time>
      </div>
      <Heading class="text-lg font-bold text-foreground">{title}</Heading>
      <p class="line-clamp-2 text-sm text-muted-foreground">{description}</p>
    </div>
  </a>
</article>
