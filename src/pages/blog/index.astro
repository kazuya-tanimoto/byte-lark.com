---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import { CategoryFilter } from "../../components/CategoryFilter";
import PageLayout from "../../layouts/PageLayout.astro";

const posts = (
  await getCollection("posts", ({ data }) => data.draft !== true)
).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<PageLayout
  title="Blog | byte-lark.com"
  description="byte-lark の技術ブログ・ライフログ記事一覧。Tech / Life のカテゴリで絞り込みできます"
>
  <h1 class="text-3xl font-bold text-foreground">Blog</h1>
  <p class="mt-4 text-muted-foreground">
    技術記事（Tech）とライフログ（Life）を新しい順に掲載しています。
  </p>

  {
    posts.length === 0 ? (
      <p class="mt-10 text-muted-foreground">記事はまだありません。</p>
    ) : (
      <>
        <div class="mt-8">
          <CategoryFilter client:load />
        </div>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {posts.map((post) => (
            <li data-blog-item data-category={post.data.category}>
              <BlogCard post={post} headingLevel="h2" />
            </li>
          ))}
        </ul>
        <p data-blog-empty hidden class="mt-6 text-muted-foreground">
          該当するカテゴリの記事はありません。
        </p>
      </>
    )
  }
</PageLayout>
