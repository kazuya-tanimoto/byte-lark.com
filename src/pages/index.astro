---
import { getCollection } from "astro:content";
import BlogCard from "../components/BlogCard.astro";
import Hero from "../components/Hero.astro";
import { Career } from "../data/career";
import { qualifications } from "../data/qualifications";
import { skills } from "../data/skills";
import BaseLayout from "../layouts/BaseLayout.astro";

// 最新記事 N=3（実データを見て決定: 現状 1 件でもレイアウトが崩れない構造にする）
const latestPosts = (
  await getCollection("posts", ({ data }) => data.draft !== true)
)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

// Skills 抜粋 M=8: 全カテゴリを flatten し経験年数の降順（年数なし=AI 活用は抜粋から除外）
const topSkills = skills
  .flatMap((set) => set.items)
  .filter((skill) => skill.years != null)
  .sort((a, b) => (b.years ?? 0) - (a.years ?? 0))
  .slice(0, 8);
---

<BaseLayout
  title="byte-lark.com"
  description="byte-lark — PM/PO・フルスタックエンジニア谷本和也のポートフォリオ・技術ブログ"
>
  <Hero />

  <main class="mx-auto max-w-5xl px-4">
    <!-- Career 抜粋（実データ 2 件のため全件表示） -->
    <section class="border-b border-border py-12" aria-labelledby="home-career">
      <div class="flex items-baseline justify-between">
        <h2 id="home-career" class="text-2xl font-bold text-foreground">Career</h2>
        <a href="/career" class="text-sm text-hibari-sky hover:underline">すべて見る →</a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          Career.map((item) => (
            <article class="rounded-lg border border-border p-5">
              <p class="text-xs text-muted-foreground">
                {item.from} 〜 {item.to ?? "現在"}
              </p>
              <h3 class="mt-1 font-semibold text-foreground">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{item.summary}</p>
              <p class="mt-3 text-xs text-muted-foreground">{item.keywords}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Skills 抜粋（M=8: 経験年数の降順） -->
    <section class="border-b border-border py-12" aria-labelledby="home-skills">
      <div class="flex items-baseline justify-between">
        <h2 id="home-skills" class="text-2xl font-bold text-foreground">Skills</h2>
        <a href="/skills" class="text-sm text-hibari-sky hover:underline">すべて見る →</a>
      </div>
      <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          topSkills.map((skill) => (
            <li class="flex items-center gap-3 rounded-lg border border-border p-3">
              {skill.icon && <img src={skill.icon} alt="" width="28" height="28" loading="lazy" />}
              <div>
                <p class="text-sm font-medium text-foreground">{skill.name}</p>
                <p class="text-xs text-muted-foreground">{skill.years} 年</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Qualifications（FR-15: 独立ページなし） -->
    <section class="border-b border-border py-12" aria-labelledby="home-qualifications">
      <h2 id="home-qualifications" class="text-2xl font-bold text-foreground">Qualifications</h2>
      <ul class="mt-6 space-y-3">
        {
          qualifications.map((q) => (
            <li class="flex flex-wrap items-baseline justify-between gap-2 border-b border-border/60 pb-3 last:border-b-0">
              <span class="font-medium text-foreground">{q.name}</span>
              <span class="text-sm text-muted-foreground">{q.acquiredAt} 取得</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 最新記事 -->
    <section class="py-12" aria-labelledby="home-blog">
      <div class="flex items-baseline justify-between">
        <h2 id="home-blog" class="text-2xl font-bold text-foreground">Blog</h2>
        <a href="/blog" class="text-sm text-hibari-sky hover:underline">すべて見る →</a>
      </div>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => <BlogCard post={post} />)}
      </div>
    </section>
  </main>
</BaseLayout>
