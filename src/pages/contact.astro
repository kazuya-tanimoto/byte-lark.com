---
import PageLayout from "../layouts/PageLayout.astro";

// Q3/Q7: 問合せメールは tanimoto@byte-lark.com に統一（PHASE1A-006 で決定）
const contactEmail = "tanimoto@byte-lark.com";
---

<PageLayout
  title="Contact | byte-lark.com"
  description="byte-lark へのお問い合わせ窓口。業務システム開発・PM / PO 支援・AWS クラウド構築のご相談を受け付けています"
>
  <h1 class="text-3xl font-bold tracking-tight text-foreground">Contact</h1>

  <p class="mt-6 leading-relaxed text-muted-foreground">
    byte-lark へのお問い合わせは、下記のメールアドレスにて受け付けています。お仕事のご相談・ご依頼のほか、記事内容に関するご質問やご指摘もお気軽にお寄せください。
  </p>

  <!-- 問合せ先 -->
  <section class="mt-10" aria-labelledby="contact-email">
    <h2 id="contact-email" class="border-b border-border pb-2 text-2xl font-bold text-foreground">
      お問い合わせ先
    </h2>
    <p class="mt-4 leading-relaxed text-muted-foreground">
      <a href={`mailto:${contactEmail}`} class="text-hibari-sky hover:underline">
        {contactEmail}
      </a>
    </p>
    <p class="mt-3 leading-relaxed text-muted-foreground">
      通常 2〜3 営業日以内にご返信いたします。お急ぎの場合はその旨をメールにご記載ください。
    </p>
  </section>

  <!-- 対応領域 -->
  <section class="mt-12" aria-labelledby="contact-scope">
    <h2 id="contact-scope" class="border-b border-border pb-2 text-2xl font-bold text-foreground">
      対応領域
    </h2>
    <p class="mt-4 leading-relaxed text-muted-foreground">
      以下のようなご相談・ご依頼を受け付けています。
    </p>
    <ul class="mt-3 list-disc space-y-2 pl-6 leading-relaxed text-muted-foreground">
      <li>業務システムの受託開発（要件定義〜設計・実装・テスト・運用保守）</li>
      <li>PM / PO としてのプロジェクト推進・開発チームのマネジメント支援</li>
      <li>AWS を中心としたクラウド環境の構築・運用改善</li>
      <li>本サイトの記事内容に関するご質問・ご指摘</li>
    </ul>
    <p class="mt-4 leading-relaxed text-muted-foreground">
      事業内容の詳細は <a href="/about" class="text-hibari-sky hover:underline">About</a>
      、これまでの実績は <a href="/career" class="text-hibari-sky hover:underline">Career</a>
      をご覧ください。
    </p>
  </section>
</PageLayout>
